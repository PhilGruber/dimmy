#!/bin/bash
set -e

# Other maintainer-script actions must not change the installation.
case "${1:-configure}" in
    configure) ;;
    *) exit 0 ;;
esac

if ! getent group dimmy >/dev/null; then
    addgroup --system dimmy
fi
if ! getent passwd dimmy >/dev/null; then
    adduser --system --ingroup dimmy --home /var/lib/dimmy \
        --no-create-home --shell /usr/sbin/nologin dimmy
fi

mkdir -p /etc/dimmy /usr/share/dimmy /var/lib/dimmy

CFG_DIR="/etc/dimmy"
DEFAULTS_DIR="/usr/share/dimmy/defaults"

CFG_FILES=(
    "dimmyd.conf.yaml"
    "rules.conf.yaml"
    "dimmy.conf"
)

for CFG_FILE in "${CFG_FILES[@]}"; do
    FULL_CFG_FILE="${CFG_DIR}/${CFG_FILE}"
    EXAMPLE_FILE="${DEFAULTS_DIR}/${CFG_FILE}.example"
    # Preserve every existing entry, including empty files and dangling symlinks.
    # noclobber also protects against a file appearing after the existence check.
    if [ ! -e "${FULL_CFG_FILE}" ] && [ ! -L "${FULL_CFG_FILE}" ] && [ -f "${EXAMPLE_FILE}" ]; then
        (set -o noclobber; cat "${EXAMPLE_FILE}" > "${FULL_CFG_FILE}")
    fi
done

chown -R dimmy:dimmy /etc/dimmy /usr/share/dimmy /var/lib/dimmy

exit 0
